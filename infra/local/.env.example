# infra/local/.env 로 복사해서 쓴다(.env 는 커밋 금지 — .gitignore).
# 로컬 개발 전용 값이다. 실제 운영 비밀번호를 여기에 쓰지 않는다.
CERA_PG_PORT=55442
CERA_DB_NAME=cera
CERA_TEST_DB_NAME=cera_test
CERA_PG_SUPERUSER_PASSWORD=change-me-local-superuser
CERA_OWNER_PASSWORD=change-me-local-owner
CERA_APP_PASSWORD=change-me-local-app

# ── Docker 로 앱 전체 실행 (compose profile app · llm · eval) ──
# 로컬 소형 모델(llama.cpp). repo:양자화 형식. 처음 켤 때 Hugging Face 에서 받아 llm-cache 볼륨에 둔다(저장소에 넣지 않는다).
# 아래로 갈수록 크다. 가장 작은 것부터 올려 본다(infra/local/eval-ladder.sh). (정확한 revision · 파일 해시 · 라이선스: ai/evals/local-models.json — 3B 는 상업 사용 불가)
#   Qwen/Qwen2.5-0.5B-Instruct-GGUF:Q4_K_M (~0.4GB)   Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M (~1.1GB)
#   Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M   (~2.1GB)   unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M (~2.5GB, 로컬 후보)
#   Qwen/Qwen2.5-7B-Instruct-GGUF:Q4_K_M   (~4.7GB, 파일 2개)
CERA_LLM_HF=Qwen/Qwen2.5-0.5B-Instruct-GGUF:Q4_K_M
# 서버가 한 번에 보는 문맥 길이(토큰). 클수록 메모리를 더 쓴다
CERA_LLM_CTX=4096
CERA_API_PORT=3100
CERA_AI_PORT=8100
CERA_LLM_PORT=8080
CERA_WEB_PORT=3000
