# CERA 공개 포트폴리오 배포 설정(T-131) — infra/portfolio/.env 로 복사해서 서버에만 둔다. **.env 는 커밋 금지**(.gitignore).
# 비밀값을 만드는 예: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
# 상용 LLM 키 · Gmail OAuth 는 여기에 없다 — 공개 데모는 녹화 재생 · Mock 메일만 쓴다(ADR-039).

# ── 필수 ──
# 공개 주소(Caddy 가 이 이름으로 HTTPS 인증서를 받는다 — DNS A/AAAA 레코드가 이 서버를 가리켜야 한다)
CERA_DOMAIN=cera.example.com
# 브라우저가 보는 출처(scheme://host[:port]) — 변경 요청의 Origin 검사(CSRF 2차 방어)에 쓴다. 기본 포트면 포트 없이
CERA_PUBLIC_ORIGIN=https://cera.example.com
# PostgreSQL: 관리자 · migration 소유 역할 · 앱 역할(서로 다른 긴 난수)
CERA_PG_SUPERUSER_PASSWORD=
CERA_OWNER_PASSWORD=
CERA_APP_PASSWORD=
# Redis 비밀번호(내부망 전용이지만 비밀번호도 건다)
CERA_REDIS_PASSWORD=
# Backend ↔ Agent Runtime 서비스 토큰(32자 이상 난수)
CERA_AGENT_TOOL_TOKEN=

# Let's Encrypt 계정 · 인증서 만료 알림 주소(운영자 본인 주소 — 화면 · 저장소에는 나오지 않는다)
CERA_ACME_EMAIL=

# ── 선택 ──
# 관리자 로그인이 필요하면 12자 이상(비우면 관리자 계정을 만들지 않는다 — 공개 데모 운영에는 필요 없다)
CERA_SEED_ADMIN_PASSWORD=
# 세션 길이(분) — 데모 방문자 세션도 같다 [ASSUMPTION]
CERA_SESSION_TTL_MINUTES=120
# 하루 전체 Agent 실행 한도 [ASSUMPTION] — 넘으면 429 DEMO_QUOTA_EXCEEDED
CERA_PORTFOLIO_MAX_AGENT_RUNS_PER_DAY=200
# HSTS 유지 시간(초). 도메인을 확정한 뒤에만 길게 — 로컬 시험(localhost)은 0
CERA_HSTS_MAX_AGE=31536000
# 공개 포트(보통 80 · 443 그대로). 로컬 시험에서 겹치면 8080 · 8443 등
CERA_HTTP_PORT=80
CERA_HTTPS_PORT=443
