# CERA Private Staging 설정(T-132) — infra/staging/.env 로 복사해서 서버(또는 개발 PC)에만 둔다. **.env 는 커밋 금지**(.gitignore).
# 공개 포트폴리오(infra/portfolio/.env)와 **다른 파일 · 다른 값**을 쓴다(DB · Redis · 토큰 공유 금지).
# 비밀값 만들기 예: openssl rand -base64 48 | tr -d '/+=\n' | cut -c1-40

# ── 필수 ──
CERA_PG_SUPERUSER_PASSWORD=
CERA_OWNER_PASSWORD=
CERA_APP_PASSWORD=
CERA_REDIS_PASSWORD=
# Backend ↔ Agent Runtime 서비스 토큰(32자+)
CERA_AGENT_TOOL_TOKEN=
# 변경 요청을 받을 출처(쉼표). 서버 주소 + SSH 터널 주소 등
CERA_ALLOWED_ORIGINS=https://staging.example.com,http://127.0.0.1:3400
# 사람 계정(12자+) — 비우면 그 역할은 만들지 않는다. npm run db:bootstrap 이 만든다
CERA_SEED_ADMIN_PASSWORD=
CERA_SEED_OPERATOR_PASSWORD=
CERA_SEED_FIELD_PASSWORD=

# ── 실제 Gmail(선택) — CERA 전용 계정. back 에서 npm run gmail:auth 로 refresh token(Testing 모드 약 7일) ──
CERA_GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCOUNT_EMAIL=
# 실제로 받을 수 있는 시험 주소(쉼표) — staging 은 비운영 환경이라 이 목록 밖으로는 나가지 않는다. 비면 실채널 발송 전부 차단
CERA_TEST_RECIPIENT_ALLOWLIST=
# true 면 승인 · 발송 요청은 되지만 Worker 가 보내지 않는다(긴급 차단)
CERA_SENDING_PAUSED=false

# ── 상용 LLM(선택) — replay(녹화 재생) | live ──
CERA_LLM_MODE=replay
CERA_LLM_PROVIDER=
CERA_LLM_MODEL=
CERA_LLM_FALLBACK_PROVIDER=
CERA_LLM_FALLBACK_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 공공데이터(선택) — off | live ──
CERA_PUBLIC_DATA_MODE=off
DATA_GO_KR_SERVICE_KEY=

# ── 기타 ──
CERA_EXCEPTION_DETECTION=on
CERA_SESSION_COOKIE_SECURE=true
CERA_SESSION_TTL_MINUTES=720
# 루프백 화면 포트(SSH 터널용)
CERA_STAGING_WEB_PORT=3400

# ── (선택) profile edge: 인터넷 주소 + HTTPS + Basic Auth ──
CERA_DOMAIN=staging.example.com
CERA_ACME_EMAIL=
CERA_HSTS_MAX_AGE=31536000
CERA_HTTP_PORT=80
CERA_HTTPS_PORT=443
CERA_STAGING_BASIC_AUTH_USER=
# 작은따옴표로 감싼 bcrypt 해시(caddy hash-password)
CERA_STAGING_BASIC_AUTH_HASH=
