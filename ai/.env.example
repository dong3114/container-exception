# CERA AI Server / Agent Runtime — copy to ai/.env (gitignored) and fill only what you use. Never commit real values.
# Every key is listed in cera_ai/config.py (tests check both directions). Check your local copy: python -m cera_ai.config
# The eval CLI (python -m cera_ai.evals) reads ai/.env; the server reads the process environment.

# ── Server ──
# local | test | staging | production. production forbids replay modes (recorded answers are not real — rule 9).
CERA_AI_ENV=local
CERA_AI_HOST=127.0.0.1
CERA_AI_PORT=8100
CERA_AI_LOG_LEVEL=INFO

# ── Generative LLM (extraction candidates · prose) — outputs are candidates; the Main Backend validates (ADR-033) ──
# replay = recorded responses, no LLM call (default) · live = needs CERA_LLM_PROVIDER + CERA_LLM_MODEL + that vendor's key
CERA_LLM_MODE=replay
# anthropic | openai | gemini — choosing one for production is an ADR decision (T-099)
CERA_LLM_PROVIDER=
CERA_LLM_MODEL=
CERA_LLM_EFFORT=
# replay fixtures (default ai/fixtures/replay)
CERA_AI_REPLAY_DIR=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Decision model (answered? committed? conditional? needs a human?) — candidates only ──
# off (default) | replay | live. live needs CERA_DECISION_PROVIDER: jev (OPENROUTER_API_KEY) | llm_judge (live LLM above) | nli
CERA_DECISION_MODE=off
CERA_DECISION_PROVIDER=
CERA_DECISION_MODEL=
# TypeSafe Jev is reached through OpenRouter's Decisions API
OPENROUTER_API_KEY=

# ── Agent Runtime (ADR-036, T-104) — LangGraph CeraRecoveryGraph; calls Main Backend typed tools + runtime API only ──
# No DB, no SQL, no channels, no public APIs from here. off (default) | on (needs a 32+ char token, same as back/.env)
CERA_AGENT_MODE=off
CERA_BACKEND_TOOL_URL=http://127.0.0.1:3100
CERA_AGENT_TOOL_TOKEN=
# hard caps per run (loop guard)
CERA_AGENT_MAX_STEPS=25
CERA_AGENT_MAX_TOOL_CALLS=12
# retries of a retryable tool failure (e.g. UPSTREAM_TIMEOUT), same idempotency key
CERA_AGENT_MAX_RETRIES=2
