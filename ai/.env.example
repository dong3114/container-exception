# CERA AI Server / Agent Runtime — copy to ai/.env (gitignored) and fill only what you use. Never commit real values.
# Every key is listed in cera_ai/config.py (tests check both directions). Check your local copy: python -m cera_ai.config
# The eval CLI (python -m cera_ai.evals) reads ai/.env; the server reads the process environment.

# ── Server ──
# local | test | staging | production. production forbids replay modes (recorded answers are not real — rule 9).
CERA_AI_ENV=local
CERA_AI_HOST=127.0.0.1
CERA_AI_PORT=8100
CERA_AI_LOG_LEVEL=INFO

# ── Generative LLM (extraction candidates · prose) — outputs are candidates; the Main Backend validates (ADR-033) ──
# replay = recorded responses, no LLM call (default) · live = needs CERA_LLM_PROVIDER + CERA_LLM_MODEL + that vendor's key
CERA_LLM_MODE=replay
# anthropic | openai | gemini | local — choosing one for production is an ADR decision (T-099)
# local = OpenAI-compatible server, no key, no cost (the compose `llm` service: llama.cpp + a quantized GGUF model)
# MVP provisional default (replaceable — final provider selection is deferred, T-099 continuous evaluation): the local Qwen3-4B-Instruct-2507 Q4_K_M
# served by the compose `llm` profile. These two lines apply only when CERA_LLM_MODE=live; replay ignores them.
CERA_LLM_PROVIDER=local
CERA_LLM_MODEL=qwen3-4b-instruct-2507-q4_k_m
CERA_LLM_EFFORT=
# Failover (optional): when the provider above fails for a technical reason only — missing / rejected key (401 · 403), rate limit (429),
# server error (5xx), timeout — the same request is tried once with this provider. Answer problems (malformed JSON, refusal,
# truncated output) are NOT failed over: they go to the backend validators and human review. Leave both empty for no failover.
# Must differ from the primary (provider or model); needs that vendor's key below. live mode only.
CERA_LLM_FALLBACK_PROVIDER=
CERA_LLM_FALLBACK_MODEL=
# replay fixtures (default ai/fixtures/replay)
CERA_AI_REPLAY_DIR=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# local vendor — outside Docker the llama.cpp server is on 8080; inside compose the AI container is given http://llm:8080/v1
CERA_LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# only if the local server requires one
CERA_LOCAL_LLM_API_KEY=
# seconds per inference request [ASSUMPTION / DEVELOPMENT SAFETY CEILING] — cold start and CPU are slow (Qwen3-4B cold start > 20 s seen, 7B CPU ~42 s/case)
CERA_LOCAL_LLM_TIMEOUT_S=300
# seconds per commercial API request (anthropic · openai · gemini) [ASSUMPTION / DEVELOPMENT SAFETY CEILING]
CERA_COMMERCIAL_LLM_TIMEOUT_S=120

# ── Decision model (answered? committed? conditional? needs a human?) — candidates only ──
# off (default) | replay | live. live needs CERA_DECISION_PROVIDER: jev (OPENROUTER_API_KEY) | llm_judge (live LLM above) | nli
CERA_DECISION_MODE=off
CERA_DECISION_PROVIDER=
CERA_DECISION_MODEL=
# TypeSafe Jev is reached through OpenRouter's Decisions API
OPENROUTER_API_KEY=

# ── Agent Runtime (ADR-036, T-104) — LangGraph CeraRecoveryGraph; calls Main Backend typed tools + runtime API only ──
# No DB, no SQL, no channels, no public APIs from here. off (default) | on (needs a 32+ char token, same as back/.env)
CERA_AGENT_MODE=off
CERA_BACKEND_TOOL_URL=http://127.0.0.1:3100
CERA_AGENT_TOOL_TOKEN=
# emergency ceilings, not product policy [ASSUMPTION / DEVELOPMENT SAFETY CEILING]: they stop runaway loops only. Lower them from observed
# distributions (back: npm run runtime:stats). Tool calls are counted per active stretch between waits.
CERA_AGENT_MAX_STEPS=100
CERA_AGENT_MAX_TOOL_CALLS=50
# retries of a retryable tool failure (e.g. UPSTREAM_TIMEOUT), same idempotency key
CERA_AGENT_MAX_RETRIES=3
