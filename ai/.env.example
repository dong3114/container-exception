# CERA AI Server — copy to ai/.env (gitignored) and fill only what you use. Never commit real values.
# Server mode (T-092): replay = recorded responses, no LLM call. live needs CERA_LLM_PROVIDER + CERA_LLM_MODEL.
CERA_LLM_MODE=replay
CERA_LLM_PROVIDER=
CERA_LLM_MODEL=
# CERA_LLM_EFFORT=low

# Provider keys (T-099 evaluation · live mode). The eval CLI reads this file; the server reads the process environment.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# TypeSafe Jev is reached through OpenRouter's Decisions API
OPENROUTER_API_KEY=
