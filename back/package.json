{
  "name": "cera-back",
  "version": "0.1.0",
  "private": true,
  "description": "CERA Main Backend — NestJS modular monolith (API + Worker processes)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev:api": "tsx watch src/main.ts",
    "dev:worker": "tsx src/worker.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:custom": "drizzle-kit generate --config drizzle.config.ts --custom",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/seed/run-seed.ts",
    "mock:reply": "tsx src/dev/mock-reply.ts",
    "env:check": "tsx src/dev/env-check.ts",
    "openapi:emit": "tsx src/openapi/emit-openapi.ts",
    "agent-tools:emit": "tsx src/agent-tools/emit-tool-contracts.ts",
    "runtime:stats": "tsx src/dev/runtime-stats.ts",
    "validator-conformance:emit": "tsx src/dev/validator-conformance.ts",
    "gmail:auth": "tsx src/dev/gmail-auth.ts",
    "gmail:tech-validation": "tsx src/dev/gmail-tech-validation.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/swagger": "12.0.2",
    "bullmq": "6.3.12",
    "canonicalize": "5.1.0",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "5.11.1",
    "highs": "1.15.3",
    "ioredis": "5.11.1",
    "pg": "8.23.0",
    "postal-mime": "4.0.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.4",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
