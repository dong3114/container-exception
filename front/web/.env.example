# front/web 설정 예시. 복사해서 .env.local 로 쓴다(.env* 는 커밋하지 않는다 — 이 예시만 예외).
# VITE_* 값은 브라우저 번들에 들어간다 — 비밀값(LLM 키 · AI Server 자격증명 · DB 접속 정보)을 절대 넣지 않는다.

# 브라우저가 Main Backend 를 부를 경로. 개발 기본 /backend(아래 프록시), 운영은 /api 또는 배포 base URL.
VITE_CERA_API_BASE=/backend

# 화면 데이터 공급자. 지금은 mock 만 있다(api 는 T-087 부터 화면별로).
VITE_CERA_PROVIDER=mock

# 개발 서버 전용: /backend/* 를 넘길 Main Backend 주소(브라우저에 노출되지 않는다).
CERA_API_URL=http://127.0.0.1:3100
